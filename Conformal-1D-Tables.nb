Cell[CellGroupData[{

Cell["Geometric Products", "Section",
 CellChangeTimes->{{3.9447057472056313`*^9, 
  3.9447057494355326`*^9}},ExpressionUUID->"15de7c04-9586-4c1b-a9c6-\
b72592d279ea"],

Cell[BoxData[
 RowBox[{
  RowBox[{"GeometricItem", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", "w"}], "}"}], ",", 
    RowBox[{
     RowBox[{"g", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"BasisList", "[", 
         RowBox[{"[", "i", "]"}], "]"}], 
        RowBox[{"\\[", "Geometric", "]"}], 
        RowBox[{"BasisList", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{"BasisList", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "\[And]", 
       RowBox[{"BasisList", "[", 
        RowBox[{"[", "j", "]"}], "]"}]}]}], ";", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"FreeQ", "[", 
        RowBox[{"g", ",", "e"}], "]"}], ",", 
       RowBox[{"Item", "[", "g", "]"}], ",", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"FreeQ", "[", 
           RowBox[{
            RowBox[{"g", "-", "w"}], ",", "e"}], "]"}], "&&", 
          RowBox[{"i", "!=", "j"}]}], ",", 
         RowBox[{"Item", "[", 
          RowBox[{"g", ",", 
           RowBox[{"Background", "->", "NonzeroColor"}]}], "]"}], ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"i", "==", "j"}], ",", 
           RowBox[{"Item", "[", 
            RowBox[{"g", ",", 
             RowBox[{"Background", "->", "MetricColor"}]}], "]"}], ",", 
           RowBox[{"Item", "[", "g", "]"}]}], "]"}]}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.866334496845352*^9, 3.866334548044365*^9}, {
