Cell[BoxData[
 RowBox[{
  RowBox[{"AntigeometricItem", "[", 
   RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"g", ",", "w"}], "}"}], ",", 
    RowBox[{
     RowBox[{"g", "=", 
      RowBox[{"Simplify", "[", 
       RowBox[{
        RowBox[{"BasisList", "[", 
         RowBox[{"[", "i", "]"}], "]"}], "\[Antigeometric]", 
        RowBox[{"BasisList", "[", 
         RowBox[{"[", "j", "]"}], "]"}]}], "]"}]}], ";", 
     RowBox[{"w", "=", 
      RowBox[{
       RowBox[{"BasisList", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "\[Or]", 
